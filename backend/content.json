  "reviews": [
    {
      "name": "Алексей и Мария",
      "project": "Резиденция «Тихий лес»",
      "text": "Хотелось, чтобы дом оставался светлым даже в пасмурные дни. В концепции это продумали — от расположения окон до оттенков отделки."
    },
    {
      "name": "Ирина",
      "project": "Вилла «Горизонт»",
      "text": "Пришла со своим дизайнером. Особенно понравилось, что решения обсуждали вместе и не приходилось передавать информацию между командами."
    },
    {
      "name": "Дмитрий",
      "project": "Дом «Сосны»",
      "text": "Самое ценное для меня — понятная последовательность этапов. Можно заранее планировать решения и видеть, что происходит на объекте."
    },
    {
      "name": "Анна и Сергей",
      "project": "Резиденция «Линия»",
      "text": "Мы начинали с нескольких фотографий и общего представления о доме. Постепенно из этого сложился понятный проект под нашу семью."
    },
    {
      "name": "Михаил",
      "project": "Дом «Тёплый камень»",
      "text": "Важно было связать дом, террасу и сад в одно пространство. Именно такой подход мы искали."
    },
    {
      "name": "Елена",
      "project": "Вилла «Воздух»",
      "text": "Заказывали только внутреннюю отделку. Понравилось внимание к мелочам: свету, расположению розеток и сочетанию материалов."
    }
  ]
}
